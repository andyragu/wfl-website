# Settings for the Write page. Add these in your hosting's environment variables
# (Vercel: Project -> Settings -> Environment Variables). Never commit real values.

# Password writers type on /write to publish. Required on the live site.
WRITER_PASSWORD=

# GitHub fine-grained token with "Contents: Read and write" on the wfl-website repo.
# When set, Publish commits the article to GitHub and the site redeploys with it.
GITHUB_TOKEN=

# Optional: defaults to andyragu/wfl-website and master.
GITHUB_REPO=
GITHUB_BRANCH=
